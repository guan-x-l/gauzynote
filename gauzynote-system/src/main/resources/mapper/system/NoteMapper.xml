<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gauzynote.system.mapper.NoteMapper">
    <resultMap type="com.gauzynote.system.domain.entity.Note" id="NoteMap">
        <result property="noteId" column="note_id" jdbcType="INTEGER"/>
        <result property="userId" column="user_id" jdbcType="INTEGER"/>
        <result property="noteName" column="note_name" jdbcType="VARCHAR"/>
        <result property="content" column="content" jdbcType="VARCHAR"/>
        <result property="contentHtml" column="content_html" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="delFlag" column="del_flag" jdbcType="VARCHAR"/>
    </resultMap>

    <!--查询单个-->
    <select id="selectById" resultMap="NoteMap">
        select *
        from note
        where note_id = #{noteId}
            and user_id = #{userId}
          and del_flag = '0'
    </select>

    <!--新增-->
    <insert id="insert" useGeneratedKeys="true" keyProperty="noteId">
        insert into note(
        <if test="userId != null and userId != ''">user_id,</if>
        <if test="noteName != null and noteName != ''">note_name,</if>
        <if test="content != null and content != ''">content,</if>
        <if test="contentHtml != null and contentHtml != ''">content_html,</if>
        create_time
        )values(
        <if test="userId != null and userId != ''">#{userId},</if>
        <if test="noteName != null and noteName != ''">#{noteName},</if>
        <if test="content != null and content != ''">#{content},</if>
        <if test="contentHtml != null and contentHtml != ''">#{contentHtml},</if>
        sysdate()
        )
    </insert>

    <!--通过主键修改数据-->
    <update id="update">
        update note
        <set>
            <if test="noteName != null and noteName != ''">note_name = #{noteName},</if>
            <if test="content != null">content = #{content},</if>
            <if test="contentHtml != null">content_html = #{contentHtml},</if>
            update_time = sysdate()
        </set>
        where note_id = #{noteId} and user_id = #{userId}
    </update>
    <update id="updateNoteName">
        update note SET note_name = #{noteName}, update_time = sysdate() where note_id = #{noteId} and user_id = #{userId}
    </update>
    <!--    通过主键删除-->
    <update id="deleteById">
        update note
        set del_flag = '2'
        where note_id = #{noteId}
          and user_id = #{userId}
    </update>

    <!--    通过主键删除-->
    <update id="deleteByIds">
        update note
        set del_flag = '2'
        where user_id = #{userId}
        and note_id in
        <foreach collection="noteIds" item="noteId" open="(" separator="," close=")">
            #{noteId}
        </foreach>
    </update>
</mapper>

